# Включаем модуль перезаписи
RewriteEngine On

# Разрешаем запросы без Host заголовка (для Docker/прокси окружений)
RewriteCond %{HTTP_HOST} ^$ [OR]
RewriteCond %{HTTP_HOST} ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+
RewriteRule .* - [E=HTTP_HOST:localhost]

# Только HTTPS доступен на localhost:8080
# HTTP отключен для простоты локальной разработки

# Редирект с www на без www (только для production, не для localhost)
# Должен быть ПЕРВЫМ, чтобы сначала убрать www, потом обработать остальное
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
RewriteCond %{SERVER_PORT} !^8080$ [NC]
RewriteCond %{HTTP_HOST} !^$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# Редирект HTTP -> HTTPS (только для production, не для localhost)
# ВАЖНО: Если редирект HTTP->HTTPS уже настроен на уровне веб-сервера/прокси (nginx, cloudflare),
# то закомментируйте этот блок, чтобы избежать циклов редиректов
# Проверяем и через HTTPS, и через X-Forwarded-Proto (для прокси/Docker)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTP:X-Forwarded-SSL} !on
RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
RewriteCond %{SERVER_PORT} !^8080$ [NC]
RewriteCond %{SERVER_PORT} !^8443$ [NC]
RewriteCond %{HTTP_HOST} ^tonirovka\.kh\.ua$ [NC]
RewriteRule ^(.*)$ https://tonirovka.kh.ua/$1 [R=301,L]

# Редирект index.html на главную (ПЕРВЫМ, до других правил)
# ВАЖНО: редирект должен работать для всех запросов к index.html
# Удаляем query string явно, добавляя ? в конец целевого URL
# Сначала обрабатываем с параметрами lang=uk или lang=ru
RewriteCond %{QUERY_STRING} ^lang=(uk|ru)$ [NC]
RewriteRule ^index\.html$ /? [R=301,L]
# Потом обрабатываем index.html с любыми другими параметрами
RewriteCond %{QUERY_STRING} .
RewriteRule ^index\.html$ /? [R=301,L]
# Потом без параметров
RewriteRule ^index\.html$ / [R=301,L]

# Редирект /ru/ на главную страницу (для одностраничного сайта с JSON-переключением языков)
# Работает для всех, включая production и localhost
# 301 редирект удаляет страницы из индекса Google
RewriteRule ^ru/?$ / [R=301,L]
RewriteRule ^ru/(.*)$ /$1 [R=301,L]

# Редирект ?lang=* на главную без параметров (для одностраничного сайта с JSON-переключением языков)
# Важно: языки переключаются через JSON на клиенте, не через URL параметры
# Это предотвращает индексирование Google разных языковых версий как отдельных страниц
RewriteCond %{QUERY_STRING} ^lang=(uk|ru)$ [NC]
RewriteRule ^/?$ / [R=301,L]

# Редирект старых страниц на главную (301 редирект для всех случаев)
# Важно: эти страницы больше не существуют, все редиректится на главную
# 301 редирект удаляет страницы из индекса Google
RewriteRule ^(services|prices|portfolio|about|contacts)\.html$ / [R=301,L]

# Защита конфигурационных файлов
<Files "admin/config.php">
    Require all denied
</Files>

# Защита служебных файлов админки (только актуальные)
<Files "admin/logging_functions.php">
    Require all denied
</Files>

# Защита от просмотра директорий
Options -Indexes

# Защита от hotlinking изображений (временно отключено для отладки)
# RewriteCond %{HTTP_REFERER} !^$
# RewriteCond %{HTTP_REFERER} !^https?://(www\.)?tonirovka\.kh\.ua [NC]
# RewriteCond %{HTTP_REFERER} !^https?://localhost(:8080)? [NC]
# RewriteRule \.(jpg|jpeg|png|gif|svg)$ - [F,L]

# Обработка ошибок
ErrorDocument 404 /404.html
ErrorDocument 403 /403.html

# Защита от выполнения PHP в загруженных файлах
<FilesMatch "\.(jpg|jpeg|png|gif|pdf|doc|docx)$">
    SetHandler default-handler
</FilesMatch>

# Защита служебных файлов
<Files "*.log">
    Require all denied
</Files>

<Files "*.bak">
    Require all denied
</Files>

<Files "*.tmp">
    Require all denied
</Files>

# Кеширование статических файлов
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

# Сжатие файлов
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Оптимизация для мобильных устройств
<IfModule mod_rewrite.c>
    # Принудительное сжатие для мобильных браузеров
    RewriteCond %{HTTP_USER_AGENT} "android|blackberry|iphone|ipod|iemobile|opera mobile|palmos|webos|googlebot-mobile" [NC]
    RewriteRule .* - [E=force-gzip:1]
</IfModule>

# Заголовки безопасности
<IfModule mod_headers.c>
    # Определяем localhost или IP адрес (для Docker)
    SetEnvIf Host "^(localhost|127\.0\.0\.1|[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+)(:.*)?$" IS_LOCALHOST
    
    # Определяем поддомены (mail, www и т.д.)
    SetEnvIf Host "^[^.]+\.tonirovka\.kh\.ua$" IS_SUBDOMAIN
    
    # HSTS только для production (не для localhost/IP) - используем SetEnvIf вместо <If>
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=!IS_LOCALHOST
    
    # Остальные заголовки безопасности для всех
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options DENY
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    
    # Предотвращаем кеширование index.html
    <Files "index.html">
        Header always set Cache-Control "no-cache, no-store, must-revalidate"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
    </Files>
    
    # Предотвращаем кеширование XML файлов
    <Files "*.xml">
        Header always set Cache-Control "no-cache, no-store, must-revalidate"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
    </Files>
    
    # Кеширование CSS и JS (обновление через версионирование файлов)
    <FilesMatch "\.(css|js)$">
        Header always set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    
    # Долгое кеширование изображений (обновление через версионирование ?v=timestamp)
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg)$">
        Header always set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>