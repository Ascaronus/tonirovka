# Apache 2.4+. The public site has one indexable URL.
Options -Indexes -MultiViews
DirectoryIndex index.html
RewriteEngine On

# Keep local development local; production redirects use a fixed trusted host.
RewriteRule ^ - [E=SEO_ORIGIN:]
RewriteCond %{HTTP_HOST} ^(?:www\.)?tonirovka\.kh\.ua(?::[0-9]+)?$ [NC]
RewriteRule ^ - [E=SEO_ORIGIN:https://tonirovka.kh.ua]

# Deny private data before any URL normalization. robots.txt is not access control.
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
RewriteRule ^(?:data|tests)(?:/|$) - [F,L,NC]
RewriteRule \.(?:sql|log|bak|tmp|backup)(?:\.|$) - [F,L,NC]
RewriteRule \.(?:md|ya?ml)$ - [F,L,NC]
RewriteRule ^Dockerfile$ - [F,L,NC]

# Retired language-only URLs: QSD really removes the query, preventing a loop.
# Do not strip marketing parameters from other URLs.
RewriteCond %{QUERY_STRING} ^lang=(uk|ru)$ [NC]
RewriteRule ^(?:index\.html|ru/?|ru/index\.html)?$ %{ENV:SEO_ORIGIN}/ [R=301,L,QSD]

# Only redirect an explicit client request, never DirectoryIndex's internal lookup.
RewriteCond %{THE_REQUEST} "\s/+index\.html(?:[?\s])" [NC]
RewriteRule ^index\.html$ %{ENV:SEO_ORIGIN}/ [R=301,L]
RewriteRule ^ru(?:/index\.html|/)?$ %{ENV:SEO_ORIGIN}/ [R=301,L]

# Existing legacy pages now correspond to sections on the home page.
RewriteRule ^(?:ru/)?services\.html$ %{ENV:SEO_ORIGIN}/#films [R=301,L,NE,QSD]
RewriteRule ^(?:ru/)?prices\.html$ %{ENV:SEO_ORIGIN}/#pricing [R=301,L,NE,QSD]
RewriteRule ^(?:ru/)?portfolio\.html$ %{ENV:SEO_ORIGIN}/#gallery [R=301,L,NE,QSD]
RewriteRule ^(?:ru/)?contacts\.html$ %{ENV:SEO_ORIGIN}/#contacts [R=301,L,NE,QSD]
RewriteRule ^(?:ru/)?about\.html$ %{ENV:SEO_ORIGIN}/ [R=301,L,QSD]
# Unknown paths (including /ru/unknown) must return 404, not a home-page redirect.

# Canonical origin, after legacy routes: one hop for www + HTTP + old page.
RewriteCond %{HTTP_HOST} ^www\.tonirovka\.kh\.ua(?::[0-9]+)?$ [NC]
RewriteRule ^ https://tonirovka.kh.ua%{REQUEST_URI} [R=301,L]
# Cityhost may terminate TLS at its reverse proxy. Keep its HTTPS signals.
RewriteCond %{HTTP_HOST} ^tonirovka\.kh\.ua(?::[0-9]+)?$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
RewriteCond %{HTTP:X-Forwarded-SSL} !^on$ [NC]
RewriteRule ^ https://tonirovka.kh.ua%{REQUEST_URI} [R=301,L]

# Direct requests to error documents must also return the matching HTTP status.
RewriteCond %{THE_REQUEST} "\s/+404\.html(?:[?\s])" [NC]
RewriteRule ^404\.html$ - [R=404,L]
RewriteCond %{THE_REQUEST} "\s/+403\.html(?:[?\s])" [NC]
RewriteRule ^403\.html$ - [F,L]
ErrorDocument 404 /404.html
ErrorDocument 403 /403.html

<FilesMatch "\.(jpg|jpeg|png|gif|pdf|doc|docx)$">
    SetHandler default-handler
</FilesMatch>
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    <FilesMatch "^(index\.html|robots\.txt|.*\.xml)$">
        Header always set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "^(403|404)\.html$">
        Header always set X-Robots-Tag "noindex, follow"
    </FilesMatch>
</IfModule>
